# Free LLM Gateway Configuration
# Copy this file to .env and fill in your API keys

# Master key for authenticating to this gateway
MASTER_KEY=your-master-key-here

# Provider API Keys (get free keys from the links below)
# AI21 Labs: https://studio.ai21.com/account/api-key
# $10 trial credits at signup, no credit card. Credits expire in 3 months. Covers Jamba Large and Jamb
AI21_LABS_KEY=

# Alibaba Cloud Model Studio: https://bailian.console.alibabacloud.com/?apiKey=1
# 1M free tokens per Qwen model on signup, expires in 90 days (International / Singapore region). No c
ALIBABA_CLOUD_MODEL_STUDIO_KEY=

# Cohere: https://dashboard.cohere.com/api-keys
# Free "Trial" API key, no credit card. 1,000 API calls/month. Non-commercial use only.
COHERE_KEY=

# DeepSeek: https://platform.deepseek.com/api_keys
# 5M free tokens on signup, no credit card. Credits expire 30 days after signup; pay-as-you-go after. 
DEEPSEEK_KEY=

# Google Gemini: https://aistudio.google.com/app/apikey
# Free tier unavailable in EU/UK/Switzerland. Free-tier prompts may be used by Google to improve produ
GOOGLE_GEMINI_KEY=

# Mistral AI: https://console.mistral.ai/api-keys
# Free "Experiment" plan, no credit card. ~1B tokens/month. Prompts may be used to improve models.
MISTRAL_KEY=

# Z AI (Zhipu AI): https://open.bigmodel.cn/usercenter/apikeys
# Permanent free models, no credit card required.
Z_AI_ZHIPU_AI_KEY=

# Cerebras: https://cloud.cerebras.ai/
# Free tier, no credit card. Ultra-fast inference (~2,600 tok/s). 1M tokens/day cap. 8K context cap on
CEREBRAS_KEY=

# Cloudflare Workers AI: https://dash.cloudflare.com/profile/api-tokens
# 10,000 Neurons/day free. 50+ models available on free tier.
CLOUDFLARE_KEY=

# GitHub Models: https://github.com/marketplace/models
# Free prototyping for all GitHub users. 45+ models. Per-request limits (8K in / 4K out).
GITHUB_KEY=

# Groq: https://console.groq.com/keys
# Free tier, no credit card. Ultra-fast LPU inference.
GROQ_KEY=
# Default reasoning_effort for Groq openai/gpt-oss-* chat (low|medium|high).
# GROQ_GPT_OSS_REASONING_EFFORT=low

# Hugging Face: https://huggingface.co/settings/tokens
# 100K monthly Inference Provider credits for free users. Routes to Fireworks, Together, Hyperbolic, N
HUGGINGFACE_KEY=

# Kilo: https://kilo.ai
# Free models with no credit card required.
KILO_KEY=

# LLM7.io: https://token.llm7.io
# Zero-friction API gateway. No registration needed for basic access. 30+ models.
LLM7_KEY=

# ModelScope: https://modelscope.cn/my/myaccesstoken
# Free API-Inference for registered users. Requires Alibaba Cloud account binding + real-name verifica
MODELSCOPE_KEY=

# Nebius: https://studio.nebius.com/settings/api-keys
# $1 free signup credits, no credit card required. 60+ open-source models via OpenAI-compatible API. E
NEBIUS_KEY=

# Nscale: https://console.nscale.com/
# $5 free signup credits, no credit card required. EU-sovereign provider; data centers in Norway. "No 
NSCALE_KEY=

# NVIDIA: https://build.nvidia.com/explore/discover
# Free with NVIDIA Developer Program membership. 100+ models. Rate-limited (no daily token cap).
NVIDIA_KEY=

# Ollama Cloud: https://ollama.com/settings/keys
# Free tier with qualitative usage limits. 400+ models from Ollama library. Not OpenAI SDK-compatible;
OLLAMA_KEY=

# OpenRouter: https://openrouter.ai/keys
# ~28 free models (marked with `:free` suffix). OpenAI SDK-compatible.
OPENROUTER_KEY=

# OVHcloud AI Endpoints: https://endpoints.ai.cloud.ovh.net/
# Free anonymous tier (no API key, no signup): 2 RPM per IP per model. 40+ open-weight models hosted i
OVHCLOUD_AI_ENDPOINTS_KEY=

# SiliconFlow: https://cloud.siliconflow.cn/account/ak
# 3 permanently free models. Free tier capped at 50 req/day; ≥10 CNY lifetime purchase raises cap to 1
SILICONFLOW_KEY=

# Aion Labs: https://www.aionlabs.ai
# Free daily token allowance, no credit card required. Specialized for roleplay and storytelling.
AION_LABS_KEY=

# Together AI: https://api.together.xyz/settings/api-keys
TOGETHER_KEY=

# Fireworks AI: https://app.fireworks.ai/
FIREWORKS_KEY=

# SambaNova: https://cloud.sambanova.ai/apis
SAMBANOVA_KEY=

# Chutes: https://chutes.ai
CHUTES_KEY=

# Novita AI: https://novita.ai
NOVITA_KEY=

# OpenAI (paid): https://platform.openai.com/api-keys
OPENAI_KEY=

# Anthropic (paid): https://console.anthropic.com/
ANTHROPIC_KEY=

# Perplexity (paid): https://www.perplexity.ai/settings/api
PERPLEXITY_KEY=

# xAI: https://console.x.ai
# $25 sign-up credit, no credit card required. One-time only; additional $150/month available via opt-
XAI_KEY=

# Cloudflare requires account ID
CLOUDFLARE_ACCOUNT_ID=

# Local LLM last-resort fallback (Ollama, LM Studio, llama.cpp, vLLM, etc.)
# When LOCAL_LLM_MODEL is set, this provider is appended to the end of every
# model fallback chain and only used after all cloud providers fail.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=llama3.2
# LOCAL_LLM_KEY=local
# LOCAL_LLM_ENABLED=true

# Server settings
HOST=0.0.0.0
PORT=8080

# Rate limit settings (requests per minute per provider, 0 = unlimited)
DEFAULT_RPM_LIMIT=0

# Cache settings
CACHE_TTL=1800
CACHE_MAX_SIZE=1000

# Queue settings
BATCH_MAX_SIZE=10